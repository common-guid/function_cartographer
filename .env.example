# ====================
# REQUIRED VARIABLES
# ====================

# OpenRouter API Key (required when using --humanify flag with CLI)
# Get your API key from: https://openrouter.ai/
HUMANIFY_OPENROUTER_API_KEY=your_openrouter_api_key_here


# ====================
# OPTIONAL VARIABLES
# ====================

# OpenRouter Base URL (optional, defaults to https://openrouter.ai/api/v1)
# Override this if using a custom OpenRouter-compatible endpoint
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Humanify Plus Model (optional, defaults to x-ai/grok-4.1-fast)
# Specify which LLM model to use for humanification
# Examples:
#   - anthropic/claude-3.5-sonnet
#   - openai/gpt-4
#   - x-ai/grok-4.1-fast
# HUMANIFY_PLUS_MODEL=x-ai/grok-4.1-fast

# CI Environment (optional, used for verbose logging in CI environments)
# Set to "true" to enable verbose logging
# CI=true
